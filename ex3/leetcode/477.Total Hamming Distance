int totalHammingDistance(int* nums, int numsSize) {
    int total = 0;
    
    // Loop through each of the 32 bit positions
    for (int i = 0; i < 32; i++) {
        int ones = 0;
        
        // Count how many numbers have the i-th bit set
        for (int j = 0; j < numsSize; j++) {
            ones += (nums[j] >> i) & 1;
        }
        
        int zeros = numsSize - ones;
        total += ones * zeros;
    }
    
    return total;
}
